# Copy to .env and fill in. Never commit .env.

# Public HTTPS address of the server (no trailing slash). MCP URL = PUBLIC_URL/mcp
PUBLIC_URL=https://mcp.example.com

# Bitrix24 portal and local application credentials
B24_PORTAL=your-portal.example.com
B24_CLIENT_ID=local.xxxxxxxxxxxxxxxx.xxxxxxxx
B24_CLIENT_SECRET=replace-me

# 32 random bytes in base64: openssl rand -base64 32
SECRET_KEY=replace-me

# Optional
# READ_ONLY=false
# READ_ONLY_USERS=12,34
# READ_ONLY_DEPARTMENTS=5,8        (needs the "department" scope)
# KNOWN_CLIENT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
# B24_MEMBER_ID=
# PORT=3000
# DATA_DIR=/data
