# Copy to .env and fill in. Never commit .env.

# Public HTTPS address of the server, with https:// and no trailing slash. MCP URL = PUBLIC_URL/mcp
PUBLIC_URL=https://mcp.example.com

# Bitrix24 portal address with https:// (a bare host gets https:// added), and local application credentials
B24_PORTAL=https://your-portal.example.com
B24_CLIENT_ID=local.xxxxxxxxxxxxxxxx.xxxxxxxx
B24_CLIENT_SECRET=replace-me

# 32 random bytes in base64: openssl rand -base64 32
SECRET_KEY=replace-me

# Optional. Keep comments on their own lines: anything after the value becomes part of the value.
# READ_ONLY: 1/true/yes/y/on or 0/false/no/n/off; any other value stops the server with a config error.
# READ_ONLY=false
# Comma-separated positive integer ids only; any other entry stops the server with a config error.
# READ_ONLY_USERS=12,34
# READ_ONLY_DEPARTMENTS needs the "department" scope of the local application.
# READ_ONLY_DEPARTMENTS=5,8
# KNOWN_CLIENT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
# B24_MEMBER_ID=
# Port on the NAS (127.0.0.1 only) that the DSM reverse proxy points to. Default 3000; change it if 3000 is taken.
# HOST_PORT=3000
# (PORT and DATA_DIR inside the container are fixed by the Docker image: 3000 and /data. Do not set them here.)
